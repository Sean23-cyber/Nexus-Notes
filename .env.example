# OPENROUTER_API_KEY: Required for free OpenRouter AI models (Meta Llama 3.3 70B, DeepSeek R1, Qwen 2.5 Coder, Gemini 2.0 Pro).
# Obtain a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# GEMINI_API_KEY: Optional for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
APP_URL="MY_APP_URL"
