# GROQ_API_KEY: Required for ultra-fast Groq LPU models (Llama 3.3 70B, Llama 3.1 8B, Mixtral).
# Obtain a free key at https://console.groq.com/keys
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# OPENROUTER_API_KEY: Optional for free OpenRouter AI models.
# Obtain a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# APP_URL: The URL where this application is hosted.
APP_URL="MY_APP_URL"
